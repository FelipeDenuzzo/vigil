rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // ── Helper: verifica se o usuário autenticado é admin ──────────────────────
    function isAdmin() {
      return request.auth != null
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }

    // ── Helper: verifica se o usuário autenticado está aprovado ─────────────────
    function isApproved() {
      return request.auth != null
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.accessStatus == 'approved';
    }

    // ── users ──────────────────────────────────────────────────────────────────
    // Usuário lê/cria o próprio documento. Admin lê e atualiza qualquer um.
    match /users/{uid} {
      // Leitura: próprio usuário ou admin
      allow read: if request.auth != null
                  && (request.auth.uid == uid || isAdmin());

      // Criação: apenas o próprio usuário, com campos controlados
      allow create: if request.auth != null
                    && request.auth.uid == uid
                    && request.resource.data.accessStatus == 'pending'
                    && request.resource.data.role == 'user';

      // Atualização/Exclusão geral: apenas admin
      allow update, delete: if isAdmin();

      // Permitir que o próprio usuário atualize apenas baseline e onboardingCompleted
      allow update: if request.auth != null
                    && request.auth.uid == uid
                    && request.resource.data.diff(resource.data).affectedKeys()
                        .hasOnly(['baseline', 'onboardingCompleted']);

      // ── consent (subcoleção) ────────────────────────────────────────────────
      // CORREGIDO: Mapeia o caminho correto da subcoleção de consentimento usada no frontend
      match /consent/{consentDoc} {
        allow read, write: if request.auth != null
                           && request.auth.uid == uid;
      }
    }

    // ── sessions ───────────────────────────────────────────────────────────────
    match /sessions/{sessionId} {
      // Leitura: próprio proprietário do dado ou administrador
      allow read: if request.auth != null
                  && (resource.data.uid == request.auth.uid || isAdmin());

      // Criação: apenas usuários com conta aprovada pelo admin
      allow create: if isApproved()
                    && request.resource.data.uid == request.auth.uid;

      // Atualização: apenas usuários aprovados, donos do dado, impedindo hijacking de UID
      allow update: if isApproved()
                    && resource.data.uid == request.auth.uid
                    && request.resource.data.uid == resource.data.uid;

      // Exclusão: apenas administradores
      allow delete: if isAdmin();
    }

    // ── sessionReports ────────────────────────────────────────────────────────
    match /sessionReports/{sessionId} {
      // Leitura: próprio proprietário do dado ou administrador
      allow read: if request.auth != null
                  && (resource.data.uid == request.auth.uid || isAdmin());

      // Criação: apenas usuários com conta aprovada pelo admin
      allow create: if isApproved()
                    && request.resource.data.uid == request.auth.uid;

      // Atualização: apenas usuários aprovados, donos do dado, impedindo hijacking de UID
      allow update: if isApproved()
                    && resource.data.uid == request.auth.uid
                    && request.resource.data.uid == resource.data.uid;

      // Exclusão: apenas administradores
      allow delete: if isAdmin();
    }

    // Bloqueia qualquer outro caminho não mapeado por padrão.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
